@"
# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Dependencies
node_modules/
vendor/

# Build & Output
/dist
/build
/out
*.exe
*.dll

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
"@ | Out-File -FilePath .gitignore -Encoding utf8